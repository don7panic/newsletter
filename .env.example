# Copy to `.env` and fill with your own values.

# Optional GitHub auth for higher API rate limits:
# GITHUB_TOKEN=ghp_xxx

# Optional X cookies for X author posts:
# X_COOKIES='auth_token=...; ct0=...'
# X_COOKIES_PATH=/absolute/path/to/x-cookies.json

# Optional advanced X overrides:
# X_WEB_BEARER_TOKEN=Bearer ...
# X_CLIENT_TRANSACTION_ID=...

# Optional AI scoring and filtering:
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=glm-5
# AI_SCORE_THRESHOLD=6.0
# HN_MIN_ITEMS_AFTER_AI=3
# GITHUB_TRENDING_MIN_ITEMS_AFTER_AI=3
